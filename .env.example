# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# Umbler Talk API bearer token (secret — do not share or commit)
UMBLER_TALK_API_TOKEN=your-umbler-talk-token-here

# Local HTTP API (src/server.ts) settings
# Shared secret required in the x-dispatch-secret header on POST /api/dispatch
DISPATCH_SECRET=change-this-secret
# Port the local API listens on
PORT=3000
# Safety limit: reject a dispatch with more contacts than this (default 20)
MAX_CONTACTS=20

# SiteFlow endpoint (POST /api/siteflow/dispatch) settings
# Shared secret required in the x-siteflow-dispatch-secret header.
# Separate from DISPATCH_SECRET. The route returns 503 while this is empty.
SITEFLOW_DISPATCH_SECRET=
# Umbler template ID for "siteflow_continuar_conversa" (provider ID — never
# hardcode it in source). Only required when DRY_RUN is off.
SITEFLOW_TEMPLATE_ID=
# Umbler template ID for "siteflow_confirmacao_contato" (visitor
# confirmation, no button). Only required to send that specific template
# when DRY_RUN is off — every other template keeps working without it.
SITEFLOW_TEMPLATE_CONFIRMACAO_CONTATO_ID=
# Umbler template ID for "siteflow_nova_solicitacao_interna" (internal
# notification, "Ver resumo do contato" quick-reply button). Same rule:
# only required to send THIS template when DRY_RUN is off.
SITEFLOW_TEMPLATE_NOTIFICACAO_INTERNA_ID=
# Dry run: validate and simulate the SiteFlow dispatch without calling Umbler.
# Set to 1 (or true) for local testing; leave unset/0 in production.
# Does not affect POST /api/dispatch.
DRY_RUN=1

# Destination phone number in E.164 format, e.g. +5521999998888
TEST_TO_PHONE=+5521999998888

# Value for template param 1 (contact name)
TEST_CONTACT_NAME=John Doe

# Value for template param 2 (contact reason / message)
TEST_REASON=Test message from zapflow PoC
